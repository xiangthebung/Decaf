{
  "manifest_version": 3,
  "name": "blokamine",
  "version": "0.7.2",
  "description": "Make social feeds less rewarding without blocking the web.",
  "permissions": ["storage", "activeTab", "alarms"],
  "action": {
    "default_title": "blokamine",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": [
        "*://instagram.com/*",
        "*://www.instagram.com/*",
        "*://discord.com/*",
        "*://www.discord.com/*",
        "*://discordapp.com/*",
        "*://www.discordapp.com/*",
        "*://reddit.com/*",
        "*://www.reddit.com/*",
        "*://old.reddit.com/*",
        "*://youtube.com/*",
        "*://www.youtube.com/*",
        "*://tiktok.com/*",
        "*://www.tiktok.com/*",
        "*://twitch.tv/*",
        "*://www.twitch.tv/*",
        "*://x.com/*",
        "*://www.x.com/*",
        "*://twitter.com/*",
        "*://www.twitter.com/*",
        "*://facebook.com/*",
        "*://www.facebook.com/*",
        "*://google.com/*",
        "*://www.google.com/*",
        "*://google.ca/*",
        "*://www.google.ca/*",
        "*://news.google.com/*",
        "*://news.google.ca/*",
        "*://images.google.com/*",
        "*://images.google.ca/*",
        "*://pinterest.com/*",
        "*://www.pinterest.com/*",
        "*://linkedin.com/*",
        "*://www.linkedin.com/*",
        "*://threads.net/*",
        "*://www.threads.net/*",
        "*://threads.com/*",
        "*://www.threads.com/*",
        "*://web.snapchat.com/*",
        "*://web.whatsapp.com/*",
        "*://messenger.com/*",
        "*://www.messenger.com/*"
      ],
      "css": ["content.css"],
      "js": ["shared.js", "content.js"],
      "run_at": "document_start"
    }
  ]
}
