{
  "manifest_version": 3,
  "name": "blokamine",
  "version": "0.7.2",
  "description": "Make social feeds less rewarding without blocking the web.",
  "permissions": ["storage", "activeTab"],
  "action": {
    "default_title": "blokamine",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": [
        "*://instagram.com/*",
        "*://*.instagram.com/*",
        "*://discord.com/*",
        "*://*.discord.com/*",
        "*://discordapp.com/*",
        "*://*.discordapp.com/*",
        "*://reddit.com/*",
        "*://*.reddit.com/*",
        "*://youtube.com/*",
        "*://*.youtube.com/*",
        "*://tiktok.com/*",
        "*://*.tiktok.com/*",
        "*://twitch.tv/*",
        "*://*.twitch.tv/*",
        "*://x.com/*",
        "*://*.x.com/*",
        "*://twitter.com/*",
        "*://*.twitter.com/*",
        "*://facebook.com/*",
        "*://*.facebook.com/*",
        "*://google.com/*",
        "*://*.google.com/*",
        "*://google.ca/*",
        "*://*.google.ca/*",
        "*://pinterest.com/*",
        "*://*.pinterest.com/*",
        "*://linkedin.com/*",
        "*://*.linkedin.com/*",
        "*://threads.net/*",
        "*://*.threads.net/*",
        "*://threads.com/*",
        "*://*.threads.com/*",
        "*://snapchat.com/*",
        "*://*.snapchat.com/*",
        "*://whatsapp.com/*",
        "*://*.whatsapp.com/*",
        "*://messenger.com/*",
        "*://*.messenger.com/*"
      ],
      "css": ["content.css"],
      "js": ["shared.js", "content.js"],
      "run_at": "document_start"
    }
  ]
}
